---
import { Picture } from 'astro:assets';
import { fotos, ABRIR_COMPLETA } from '../data/fotos';
import { hospedajeFeatures } from '../data/services';
import { RESERVATION_ANCHOR } from '../data/site';

// Iconos SVG (line) mapeados por clave. Sin librerías externas.
const icons: Record<string, string> = {
  home: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>',
  heart: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>',
  chat: '<path d="M21 11.5a8.4 8.4 0 0 1-9 8.4L3 21l1.1-3.3A8.4 8.4 0 1 1 21 11.5Z"/>',
};
---

<section id="hospedaje" class="bg-hueso py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-700 tracking-[0.05em] text-albero-ink">
        Hospedaje canino
      </p>
      <h2 class="text-balance font-display text-3xl font-600 text-rio sm:text-4xl lg:text-[2.9rem]">
        Un hotel para perros en Mula, dedicado solo al hospedaje
      </h2>
      <p class="mt-4 text-pretty text-lg text-tinta/75">
        Alojamiento y hospedaje canino en Mula y la Región de Murcia: cuidamos
        de tu perro mientras estás fuera, con trato cercano.
      </p>
    </div>

    <!--
      Composición asimétrica: la fotografía ancla la columna estrecha y las
      cuatro características quedan en un bloque 2×2. La foto sustituye a la
      cuarta columna de tarjetas, no se suma a ellas.
    -->
    <div class="mt-12 grid gap-5 lg:grid-cols-[0.8fr_1.2fr]">
      <figure class="flex flex-col">
        <div
          class="relative aspect-[4/5] overflow-hidden rounded-card border border-piedra lg:aspect-auto lg:flex-1"
        >
          <a
            href={fotos.boxesDetalle.completa.src}
            target="_blank"
            rel="noopener"
            class="block h-full w-full"
          >
            <Picture
              src={fotos.boxesDetalle.src}
              alt={fotos.boxesDetalle.alt}
              formats={['avif', 'webp']}
              widths={[360, 640, 860, 1280]}
              sizes="(min-width: 1024px) 430px, calc(100vw - 2.5rem)"
              loading="lazy"
              class="h-full w-full object-cover"
            />
            <span class="sr-only">{ABRIR_COMPLETA}</span>
          </a>
        </div>
        <figcaption class="mt-3 text-sm text-tinta/70">
          {fotos.boxesDetalle.caption}
        </figcaption>
      </figure>

      <ul class="grid gap-5 sm:grid-cols-2">
      {
        hospedajeFeatures.map((feature, i) => {
          // Una card en verde río rompe la rejilla para que no sean «4 iguales».
          const dark = i === 1;
          return (
          <li>
            <article class={`group relative flex h-full flex-col rounded-card p-7 shadow-sm transition-all duration-300 hover:shadow-md ${dark ? 'border border-rio bg-rio text-hueso hover:shadow-rio/20' : 'border border-piedra bg-crema hover:border-albero/40 hover:shadow-rio/5'}`}>
              <span
                class={`mb-5 inline-flex h-12 w-12 items-center justify-center rounded-2xl transition-colors ${dark ? 'bg-hueso/10 text-albero-soft group-hover:bg-albero group-hover:text-rio' : 'bg-ribera/12 text-rio group-hover:bg-albero group-hover:text-hueso'}`}
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="h-6 w-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[feature.icon] ?? icons.home}
                />
              </span>
              <h3 class={`font-display text-xl font-600 ${dark ? 'text-hueso' : 'text-rio'}`}>
                {feature.title}
              </h3>
              <p class={`mt-2 flex-1 text-pretty ${dark ? 'text-hueso/80' : 'text-tinta/75'}`}>
                {feature.description}
              </p>
            </article>
          </li>
          );
        })
      }
      </ul>
    </div>

    <div class="mt-10">
      <a
        href={RESERVATION_ANCHOR}
        class="inline-flex items-center gap-2 font-700 text-albero-ink underline-offset-4 hover:underline"
      >
        Solicita la reserva de tu perro
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
