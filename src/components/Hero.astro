---
import { site, RESERVATION_ANCHOR } from '../data/site';
---

<section
  id="inicio"
  class="relative overflow-hidden bg-rio text-hueso"
>
  <!-- Atmósfera: degradado cálido + grano -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_90%_at_85%_-10%,rgba(214,138,99,0.35),transparent_55%),radial-gradient(90%_70%_at_0%_110%,rgba(123,138,108,0.45),transparent_60%)]"
    aria-hidden="true"
  >
  </div>
  <div class="bg-grain pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

  <div
    class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:py-28"
  >
    <div>
      <p
        class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-hueso/25 bg-hueso/10 px-4 py-1.5 text-xs font-700 uppercase tracking-[0.16em] text-albero-soft"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-albero-soft opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-albero-soft"></span>
        </span>
        {site.status} · {site.locality}, {site.regionShort}
      </p>

      <h1
        class="reveal text-balance font-display text-4xl font-600 leading-[1.05] sm:text-5xl lg:text-6xl"
        style="animation-delay:.08s"
      >
        Hotel y residencia canina en Mula para cuidar de tu perro
        <span class="text-albero-soft"> cuando lo necesites</span>
      </h1>

      <p
        class="reveal mt-6 max-w-xl text-pretty text-lg leading-relaxed text-hueso/85"
        style="animation-delay:.16s"
      >
        Hospedaje y alojamiento para perros en Mula y la Región de Murcia. Nos
        dedicamos en exclusiva al cuidado de tu perro mientras estás fuera.
        Solicita tu reserva online y te respondemos personalmente para confirmar
        disponibilidad.
      </p>

      <div
        class="reveal mt-9 flex flex-col gap-3 sm:flex-row sm:items-center"
        style="animation-delay:.24s"
      >
        <a
          href={RESERVATION_ANCHOR}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-hueso px-7 py-4 text-base font-700 text-rio shadow-lg shadow-black/20 transition-all hover:bg-piedra hover:shadow-xl"
        >
          Solicitar reserva
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Línea de río: hilo de marca que se dibuja bajo el CTA -->
      <svg
        class="mt-10 h-3 w-full max-w-md text-albero-soft/60"
        viewBox="0 0 600 16"
        fill="none"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          class="river-draw"
          pathLength="1"
          d="M0 8 q 50 -6 100 0 t 100 0 t 100 0 t 100 0 t 100 0 t 100 0"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>

    </div>

    <!-- Bloque visual preparado para imagen real -->
    <div class="reveal relative" style="animation-delay:.2s">
      <!--
        PROPIETARIO: sustituye este bloque por una foto real del hotel o de
        perros felices. Recomendado: <img> en /public/images/ con alt descriptivo.
      -->
      <figure
        class="relative aspect-[4/5] overflow-hidden rounded-xl2 border border-hueso/15 bg-[linear-gradient(160deg,#3c5045,#233028)] shadow-2xl"
      >
        <div class="bg-grain absolute inset-0 opacity-40" aria-hidden="true"></div>
        <figcaption
          class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-gradient-to-t from-rio/90 to-transparent p-6"
        >
          <span class="font-display text-xl text-hueso"
            >Espacios pensados<br />para descansar y jugar</span
          >
          <svg viewBox="0 0 24 24" class="h-9 w-9 shrink-0 text-albero-soft" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 9c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0" />
            <path d="M2 15c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0" />
          </svg>
        </figcaption>
      </figure>
      <div
        class="absolute -left-4 -top-4 hidden rotate-[-4deg] rounded-2xl bg-hueso px-5 py-3 text-rio shadow-xl sm:block"
      >
        <p class="font-display text-sm font-600">Abierto en Mula</p>
        <p class="text-xs text-ribera">Hospedaje y residencia canina</p>
      </div>
    </div>
  </div>
</section>
