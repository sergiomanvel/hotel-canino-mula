---
import { site, WHATSAPP_LINK, RESERVATION_ANCHOR } from '../data/site';
---

<section
  id="inicio"
  class="relative overflow-hidden bg-forest text-cream"
>
  <!-- Atmósfera: degradado cálido + grano -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_90%_at_85%_-10%,rgba(214,138,99,0.35),transparent_55%),radial-gradient(90%_70%_at_0%_110%,rgba(123,138,108,0.45),transparent_60%)]"
    aria-hidden="true"
  >
  </div>
  <div class="bg-grain pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

  <div
    class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:py-28"
  >
    <div>
      <p
        class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-cream/25 bg-cream/10 px-4 py-1.5 text-xs font-700 uppercase tracking-[0.16em] text-clay-soft"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-clay-soft opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-clay-soft"></span>
        </span>
        {site.status} · {site.locality}, {site.regionShort}
      </p>

      <h1
        class="reveal text-balance font-display text-4xl font-600 leading-[1.05] sm:text-5xl lg:text-6xl"
        style="animation-delay:.08s"
      >
        Hotel y residencia canina en Mula para cuidar de tu perro
        <span class="text-clay-soft"> cuando lo necesites</span>
      </h1>

      <p
        class="reveal mt-6 max-w-xl text-pretty text-lg leading-relaxed text-cream/85"
        style="animation-delay:.16s"
      >
        Hospedaje y alojamiento para perros en Mula y la Región de Murcia. Nos
        dedicamos en exclusiva al cuidado de tu perro mientras estás fuera.
        Solicita tu reserva online y te confirmamos personalmente.
      </p>

      <div
        class="reveal mt-9 flex flex-col gap-3 sm:flex-row sm:items-center"
        style="animation-delay:.24s"
      >
        <a
          href={RESERVATION_ANCHOR}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-cream px-7 py-4 text-base font-700 text-forest shadow-lg shadow-black/20 transition-all hover:bg-sand hover:shadow-xl"
        >
          Solicitar reserva
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={WHATSAPP_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2.5 rounded-full border border-cream/30 px-7 py-4 text-base font-700 text-cream transition-colors hover:bg-cream/10"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zM6.597 20.13c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.512 5.26l-.999 3.648 3.976-1.207zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"></path>
          </svg>
          Consultar por WhatsApp
        </a>
      </div>

      <p class="reveal mt-5 text-sm text-cream/65" style="animation-delay:.3s">
        Te respondemos por WhatsApp: {site.whatsappDisplay}
      </p>
    </div>

    <!-- Bloque visual preparado para imagen real -->
    <div class="reveal relative" style="animation-delay:.2s">
      <!--
        PROPIETARIO: sustituye este bloque por una foto real del hotel o de
        perros felices. Recomendado: <img> en /public/images/ con alt descriptivo.
      -->
      <figure
        class="relative aspect-[4/5] overflow-hidden rounded-xl2 border border-cream/15 bg-[linear-gradient(160deg,#5b6b4e,#2e4034)] shadow-2xl"
      >
        <div class="bg-grain absolute inset-0 opacity-40" aria-hidden="true"></div>
        <figcaption
          class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-gradient-to-t from-forest/90 to-transparent p-6"
        >
          <span class="font-display text-xl text-cream"
            >Espacios pensados<br />para descansar y jugar</span
          >
          <svg viewBox="0 0 24 24" class="h-9 w-9 shrink-0 text-clay-soft" fill="currentColor" aria-hidden="true">
            <path d="M6.5 11.5a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm11 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm-7.6-3.2a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm4.2 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4ZM12 12.5c2.5 0 4.8 1.9 5.3 4.3.3 1.4-.8 2.7-2.2 2.7-.9 0-1.7-.4-3.1-.4s-2.2.4-3.1.4c-1.4 0-2.5-1.3-2.2-2.7.5-2.4 2.8-4.3 5.3-4.3Z"></path>
          </svg>
        </figcaption>
      </figure>
      <div
        class="absolute -left-4 -top-4 hidden rotate-[-4deg] rounded-2xl bg-cream px-5 py-3 text-forest shadow-xl sm:block"
      >
        <p class="font-display text-sm font-600">Próxima apertura</p>
        <p class="text-xs text-moss">Mula · Región de Murcia</p>
      </div>
    </div>
  </div>
</section>
