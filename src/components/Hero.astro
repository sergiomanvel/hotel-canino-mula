---
import { Picture } from 'astro:assets';
import { fotos, ABRIR_COMPLETA } from '../data/fotos';
import { site, RESERVATION_ANCHOR } from '../data/site';
---

<section
  id="inicio"
  class="relative overflow-hidden bg-rio text-hueso"
>
  <!-- Atmósfera: degradado cálido + grano -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_90%_at_85%_-10%,rgba(214,138,99,0.35),transparent_55%),radial-gradient(90%_70%_at_0%_110%,rgba(123,138,108,0.45),transparent_60%)]"
    aria-hidden="true"
  >
  </div>
  <div class="bg-grain pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

  <div
    class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:py-28"
  >
    <div>
      <!--
        Sin `reveal` en el bloque de texto: esa clase parte de `opacity: 0` y
        Chrome no toma como candidato a LCP un nodo con opacidad 0, así que el
        stagger (0 / .08 / .16 / .24 s) retrasaba el propio LCP —el párrafo de
        aquí abajo— sin aportar nada a la lectura. Medido: -830 ms de LCP móvil.
        El contenido principal está disponible en el primer paint.
      -->
      <p class="mb-5 text-base font-600 text-albero-soft">
        Abierto en Ctra. de Pliego, Mula
      </p>

      <h1
        class="text-balance font-display text-4xl font-600 leading-[1.05] sm:text-5xl lg:text-6xl"
      >
        Hotel y residencia canina en Mula para cuidar de tu perro
        <span class="text-albero-soft"> cuando lo necesites</span>
      </h1>

      <p class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-hueso/85">
        Hospedaje y alojamiento para perros en Mula y la Región de Murcia. Nos
        dedicamos en exclusiva al cuidado de tu perro mientras estás fuera.
        Solicita tu reserva online y te respondemos personalmente para confirmar
        disponibilidad.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={RESERVATION_ANCHOR}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-hueso px-7 py-4 text-base font-700 text-rio shadow-lg shadow-black/20 transition-all hover:bg-piedra hover:shadow-xl"
        >
          Solicitar reserva
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Línea de río: hilo de marca que se dibuja bajo el CTA -->
      <svg
        class="mt-10 h-3 w-full max-w-md text-albero-soft/60"
        viewBox="0 0 600 16"
        fill="none"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          class="river-draw"
          pathLength="1"
          d="M0 8 q 50 -6 100 0 t 100 0 t 100 0 t 100 0 t 100 0 t 100 0"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>

    </div>

    <!--
      Fotografía real de las instalaciones. En móvil el LCP es el párrafo
      introductorio; en escritorio, al quitarle el reveal, pasa a serlo esta
      imagen, y aun así llega antes que con la animación (LCP escritorio
      1.292 → 1.182 ms). Mantiene prioridad de red normal: no es el LCP móvil,
      y adelantarla se la quitaría al texto que sí lo marca. Sin texto ni
      degradado encima: la imagen se lee entera y el titular vive en la columna
      de al lado.
    -->
    <div class="relative">
      <figure
        class="relative aspect-[4/5] overflow-hidden rounded-xl2 border border-hueso/15 shadow-2xl"
      >
        <a
          href={fotos.boxesContraluz.completa.src}
          target="_blank"
          rel="noopener"
          class="block h-full w-full"
        >
          <Picture
            src={fotos.boxesContraluz.src}
            alt={fotos.boxesContraluz.alt}
            formats={['avif', 'webp']}
            widths={[360, 720, 940, 1440]}
            sizes="(min-width: 1024px) 470px, calc(100vw - 2.5rem)"
            loading="eager"
            decoding="async"
            fetchpriority="auto"
            class="h-full w-full object-cover"
          />
          <span class="sr-only">{ABRIR_COMPLETA}</span>
        </a>
      </figure>
    </div>
  </div>
</section>
