---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer id="contacto" class="border-t border-hueso/10 bg-rio text-hueso">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-hueso/10 text-hueso" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 9c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0" />
            <path d="M2 15c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0" />
          </svg>
        </span>
        <span class="font-display text-lg font-600">{site.name}</span>
      </div>
      <p class="mt-4 max-w-sm text-pretty text-hueso/70">
        Hotel y residencia canina en Mula, Región de Murcia. Hospedaje para tu
        perro con cuidado cercano.
      </p>
      <p class="mt-3 text-sm font-600 text-albero-soft">Abierto en Mula</p>
    </div>

    <nav aria-label="Enlaces del pie">
      <h2 class="font-display text-base font-600 text-hueso/70">Secciones</h2>
      <ul class="mt-4 space-y-2.5 text-hueso/80">
        <li><a href="#hospedaje" class="hover:text-albero-soft">Hospedaje</a></li>
        <li><a href="#galeria" class="hover:text-albero-soft">Galería</a></li>
        <li><a href="#reservas" class="hover:text-albero-soft">Reservas</a></li>
        <li><a href="#faq" class="hover:text-albero-soft">Preguntas frecuentes</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="font-display text-base font-600 text-hueso/70">Contacto</h2>
      <ul class="mt-4 space-y-2.5 text-hueso/80">
        <li>
          <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-albero-soft">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.07 1.2.05 1.8.25 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.15.4.35 1 .4 2.2.07 1.2.07 1.6.07 4.8s0 3.6-.07 4.8c-.05 1.2-.25 1.8-.4 2.2a3.9 3.9 0 0 1-.9 1.4 3.9 3.9 0 0 1-1.4.9c-.4.15-1 .35-2.2.4-1.2.07-1.6.07-4.8.07s-3.6 0-4.8-.07c-1.2-.05-1.8-.25-2.2-.4a3.9 3.9 0 0 1-1.4-.9 3.9 3.9 0 0 1-.9-1.4c-.15-.4-.35-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.8c.05-1.2.25-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.15 1-.35 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.1 0-3.5 0-4.7.07-.9.04-1.4.2-1.7.3-.4.17-.7.37-1 .67-.3.3-.5.6-.67 1-.1.3-.26.8-.3 1.7C3.3 8.5 3.3 8.9 3.3 12s0 3.5.07 4.7c.04.9.2 1.4.3 1.7.17.4.37.7.67 1 .3.3.6.5 1 .67.3.1.8.26 1.7.3 1.2.07 1.6.07 4.7.07s3.5 0 4.7-.07c.9-.04 1.4-.2 1.7-.3.4-.17.7-.37 1-.67.3-.3.5-.6.67-1 .1-.3.26-.8.3-1.7.07-1.2.07-1.6.07-4.7s0-3.5-.07-4.7c-.04-.9-.2-1.4-.3-1.7a2.7 2.7 0 0 0-.67-1 2.7 2.7 0 0 0-1-.67c-.3-.1-.8-.26-1.7-.3C15.5 4 15.1 4 12 4Zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 1.8a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Zm5.1-.9a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z"></path></svg>
            Instagram: {site.instagramHandle}
          </a>
        </li>
        <li class="flex items-start gap-2 text-hueso/80">
          <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <span>
            {site.addressDisplay}<br />
            <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="font-600 text-albero-soft underline-offset-4 hover:underline">Cómo llegar</a>
          </span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-hueso/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-6 text-sm text-hueso/60 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p>© {year} {site.name}. Todos los derechos reservados.</p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href="/privacidad" class="hover:text-albero-soft">Política de privacidad</a>
        <span>{site.locality}, {site.region} · {site.country}</span>
      </div>
    </div>
  </div>
</footer>
