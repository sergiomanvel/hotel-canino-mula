---
import { RESERVATION_ANCHOR } from '../data/site';

const navLinks = [
  { href: '#hospedaje', label: 'Hospedaje' },
  { href: '#galeria', label: 'Galería' },
  { href: '#reservas', label: 'Reservas' },
  { href: '#faq', label: 'FAQ' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header
  class="sticky top-0 z-40 border-b border-tinta/10 bg-hueso/85 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8"
    aria-label="Navegación principal"
  >
    <!-- Logo / nombre -->
    <!--
      Sin `aria-label`: el nombre accesible sale del texto visible («Río Mula
      Hotel Canino») y así coincide con lo que se lee en pantalla (WCAG 2.5.3).
      El icono va `aria-hidden` para no ensuciarlo.
    -->
    <a href="#inicio" class="group flex items-center gap-2.5">
      <span
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-rio text-hueso transition-transform group-hover:-rotate-6"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 9c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0" />
          <path d="M2 15c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0" />
        </svg>
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-display text-lg font-600 text-rio">Río Mula</span>
        <span class="text-[0.65rem] font-600 uppercase tracking-[0.18em] text-ribera"
          >Hotel Canino</span
        >
      </span>
    </a>

    <!-- Navegación escritorio -->
    <ul class="hidden items-center gap-7 lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-600 text-tinta/80 transition-colors hover:text-albero-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <!-- CTA principal -->
      <a
        href={RESERVATION_ANCHOR}
        class="hidden items-center gap-2 rounded-full bg-rio px-5 py-2.5 text-sm font-700 text-hueso shadow-sm transition-all hover:bg-ribera hover:shadow-md sm:inline-flex"
      >
        Solicitar reserva
      </a>

      <!-- Botón menú móvil -->
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-tinta/15 text-rio lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path id="icon-open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          <path id="icon-close" class="hidden" stroke-linecap="round" d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden border-t border-tinta/10 bg-hueso lg:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col gap-1 px-5 py-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-3 py-3 text-base font-600 text-tinta hover:bg-piedra/60"
              data-mobile-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href={RESERVATION_ANCHOR}
          class="flex items-center justify-center gap-2 rounded-full bg-rio px-5 py-3.5 text-base font-700 text-hueso transition-colors hover:bg-ribera"
          data-mobile-link
        >
          Solicitar reserva
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function setOpen(open: boolean) {
    if (!menu || !toggle) return;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });

  document
    .querySelectorAll('[data-mobile-link]')
    .forEach((link) => link.addEventListener('click', () => setOpen(false)));
</script>
