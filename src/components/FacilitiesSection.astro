---
// PROPIETARIO: sustituye los bloques visuales por fotos reales cuando las tengas.
// Usa <img src="/images/..." alt="descripción" loading="lazy" /> con alt descriptivo.

const cards = [
  {
    label: 'Espacios preparados',
    text: 'Zonas pensadas para perros, cómodas y fáciles de mantener limpias.',
    tone: 'from-moss to-forest-700',
  },
  {
    label: 'Descanso y cuidado',
    text: 'Lugares tranquilos para que tu perro descanse bien.',
    tone: 'from-clay to-bark',
  },
  {
    label: 'Tiempo al aire libre',
    text: 'Espacio para moverse, jugar y disfrutar del día.',
    tone: 'from-moss-soft to-moss',
  },
];
---

<section id="instalaciones" class="bg-cream py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-700 uppercase tracking-[0.16em] text-clay">
        Instalaciones
      </p>
      <h2 class="text-balance font-display text-3xl font-600 text-forest sm:text-4xl">
        Un entorno pensado para tu perro
      </h2>
      <p class="mt-4 text-pretty text-lg text-bark/75">
        Estamos preparando espacios cómodos y seguros. Pronto publicaremos fotos
        reales de las instalaciones.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        cards.map((card) => (
          <figure class={`group relative aspect-[4/3] overflow-hidden rounded-xl2 border border-bark/10 bg-gradient-to-br ${card.tone}`}>
            <div class="bg-grain absolute inset-0 opacity-40" aria-hidden="true" />
            <span class="absolute right-4 top-4 rounded-full bg-cream/90 px-3 py-1 text-xs font-700 uppercase tracking-wide text-bark">
              Imagen provisional
            </span>
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent p-6">
              <p class="font-display text-xl font-600 text-cream">{card.label}</p>
              <p class="mt-1 text-sm text-cream/85">{card.text}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-bark/60">
      * Imágenes provisionales hasta disponer de fotografías reales del hotel.
    </p>
  </div>
</section>
