---
import { site, RESERVATION_ANCHOR } from '../data/site';
---

<section id="apertura" class="bg-rio py-20 text-hueso sm:py-28">
  <div class="relative mx-auto max-w-4xl px-5 text-center sm:px-8">
    <p class="mb-4 font-display text-lg font-600 text-albero-soft">Estamos abiertos</p>
    <h2 class="text-balance font-display text-3xl font-600 leading-tight sm:text-4xl lg:text-5xl">
      Ya cuidamos de tu perro en Mula
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-pretty text-lg text-hueso/85">
      Estamos abiertos en Mula. Envíanos tu solicitud de reserva para consultar
      disponibilidad y reservar la estancia de tu perro; te confirmamos
      personalmente.
    </p>
    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={RESERVATION_ANCHOR}
        class="inline-flex items-center justify-center gap-2.5 rounded-full bg-hueso px-7 py-4 text-base font-700 text-rio shadow-lg shadow-black/20 transition-all hover:bg-piedra"
      >
        Solicitar reserva
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="mt-5 text-sm text-hueso/60">
      Síguenos en Instagram <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="font-600 text-albero-soft underline underline-offset-4">{site.instagramHandle}</a> para ver novedades.
    </p>
  </div>
</section>
