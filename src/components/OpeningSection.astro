---
import { site, WHATSAPP_LINK } from '../data/site';
---

<section id="apertura" class="bg-forest py-20 text-cream sm:py-28">
  <div class="relative mx-auto max-w-4xl px-5 text-center sm:px-8">
    <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-cream/20 bg-cream/10 px-4 py-1.5 text-xs font-700 uppercase tracking-[0.16em] text-clay-soft">
      {site.status}
    </p>
    <h2 class="text-balance font-display text-3xl font-600 leading-tight sm:text-4xl lg:text-5xl">
      Próxima apertura en Mula, Murcia
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-pretty text-lg text-cream/85">
      Estamos terminando de preparar todo para recibir a tu perro. Aún no
      tenemos fecha pública de apertura, pero ya puedes escribirnos por WhatsApp
      para pedir información, consultar disponibilidad o reservar tu plaza.
    </p>
    <div class="mt-9 flex justify-center">
      <a
        href={WHATSAPP_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 rounded-full bg-whatsapp px-7 py-4 text-base font-700 text-white shadow-lg shadow-black/20 transition-all hover:bg-whatsapp-dark"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zM6.597 20.13c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.512 5.26l-.999 3.648 3.976-1.207zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"></path>
        </svg>
        Escríbenos por WhatsApp
      </a>
    </div>
    <p class="mt-5 text-sm text-cream/60">
      Síguenos en Instagram <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="font-600 text-clay-soft underline-offset-4 hover:underline">{site.instagramHandle}</a> para ver novedades.
    </p>
  </div>
</section>
