---
import { RESERVATION_ANCHOR } from '../data/site';
---

<section class="bg-cream py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div
      class="relative overflow-hidden rounded-xl2 bg-clay px-7 py-14 text-center text-cream sm:px-12 sm:py-20"
    >
      <div class="bg-grain pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(80%_120%_at_50%_-20%,rgba(246,241,231,0.25),transparent_60%)]"
        aria-hidden="true"
      ></div>

      <div class="relative">
        <h2 class="mx-auto max-w-2xl text-balance font-display text-3xl font-600 leading-tight sm:text-4xl lg:text-5xl">
          ¿Tu perro necesita un sitio de confianza en Mula?
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-pretty text-lg text-cream/90">
          Envía tu solicitud de reserva y te confirmamos personalmente. Sin
          compromiso.
        </p>
        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={RESERVATION_ANCHOR}
            class="inline-flex items-center justify-center gap-2.5 rounded-full bg-cream px-8 py-4 text-base font-700 text-forest shadow-xl transition-transform hover:scale-[1.02]"
          >
            Solicitar reserva
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
