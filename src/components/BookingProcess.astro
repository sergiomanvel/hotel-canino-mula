---
import { RESERVATION_ANCHOR } from '../data/site';

const steps = [
  {
    n: '01',
    title: 'Rellena la solicitud',
    text: 'Completa el formulario con tus datos, los de tu perro y las fechas aproximadas.',
  },
  {
    n: '02',
    title: 'Te respondemos',
    text: 'Revisamos tu solicitud y te contactamos por teléfono o email.',
  },
  {
    n: '03',
    title: 'Confirmamos disponibilidad',
    text: 'Vemos fechas y opciones. Tu reserva no queda confirmada hasta este paso.',
  },
  {
    n: '04',
    title: 'Todo listo',
    text: 'Cerramos los detalles para que tu perro esté bien cuidado durante su estancia.',
  },
];
---

<section id="proceso" class="bg-hueso py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-700 tracking-[0.05em] text-albero-ink">
        Cómo reservar
      </p>
      <h2 class="text-balance font-display text-2xl font-600 text-rio sm:text-3xl">
        Reservar es muy sencillo
      </h2>
      <p class="mt-4 text-pretty text-lg text-tinta/75">
        Empieza por el formulario de reserva y nosotros te confirmamos. En cuatro
        pasos.
      </p>
    </div>

    <!-- Línea de río: hilo conductor que conecta los pasos (oculto en móvil) -->
    <svg
      class="mt-10 hidden h-4 w-full text-albero-ink/30 sm:block"
      viewBox="0 0 1200 20"
      fill="none"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        class="river-draw"
        pathLength="1"
        d="M0 10 q 75 -7 150 0 t 150 0 t 150 0 t 150 0 t 150 0 t 150 0 t 150 0 t 150 0"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
      />
    </svg>

    <ol class="mt-6 grid gap-5 sm:mt-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step) => (
          <li class="relative flex h-full flex-col rounded-card border border-piedra bg-crema p-7 shadow-sm transition-all duration-300 hover:border-albero/40 hover:shadow-md hover:shadow-rio/5">
            <span class="font-display text-4xl font-600 text-albero-ink/80">{step.n}</span>
            <h3 class="mt-3 font-display text-lg font-600 text-rio">
              {step.title}
            </h3>
            <p class="mt-2 text-pretty text-tinta/75">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10">
      <a
        href={RESERVATION_ANCHOR}
        class="inline-flex items-center justify-center gap-2.5 rounded-full bg-rio px-7 py-4 text-base font-700 text-hueso shadow-sm transition-all hover:bg-ribera"
      >
        Solicitar reserva
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
