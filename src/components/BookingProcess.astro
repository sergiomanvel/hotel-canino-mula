---
import { RESERVATION_ANCHOR } from '../data/site';

const steps = [
  {
    n: '01',
    title: 'Rellena la solicitud',
    text: 'Completa el formulario con tus datos, los de tu perro y las fechas aproximadas.',
  },
  {
    n: '02',
    title: 'Te respondemos',
    text: 'Revisamos tu solicitud y te contactamos por teléfono o email.',
  },
  {
    n: '03',
    title: 'Confirmamos disponibilidad',
    text: 'Vemos fechas y opciones. Tu reserva no queda confirmada hasta este paso.',
  },
  {
    n: '04',
    title: 'Todo listo',
    text: 'Cerramos los detalles para que tu perro esté bien cuidado durante su estancia.',
  },
];
---

<section id="proceso" class="bg-cream py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-700 uppercase tracking-[0.16em] text-clay">
        Cómo reservar
      </p>
      <h2 class="text-balance font-display text-3xl font-600 text-forest sm:text-4xl">
        Reservar es muy sencillo
      </h2>
      <p class="mt-4 text-pretty text-lg text-bark/75">
        Empieza por el formulario de reserva y nosotros te confirmamos. En cuatro
        pasos.
      </p>
    </div>

    <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step) => (
          <li class="relative flex h-full flex-col rounded-xl2 border border-bark/10 bg-white/70 p-7">
            <span class="font-display text-4xl font-600 text-clay/70">{step.n}</span>
            <h3 class="mt-3 font-display text-lg font-600 text-forest">
              {step.title}
            </h3>
            <p class="mt-2 text-pretty text-bark/75">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10">
      <a
        href={RESERVATION_ANCHOR}
        class="inline-flex items-center justify-center gap-2.5 rounded-full bg-forest px-7 py-4 text-base font-700 text-cream shadow-sm transition-all hover:bg-forest-700"
      >
        Solicitar reserva
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
