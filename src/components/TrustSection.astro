---
const pillars = [
  {
    title: 'Cuidado cercano',
    text: 'Tratamos a cada perro como si fuera nuestro, con atención de verdad.',
    icon: '<path d="M12 20s-7-4.5-9.5-9C1 8 2.5 4.5 6 4.5c2 0 3 1.2 4 2.5 1-1.3 2-2.5 4-2.5 3.5 0 5 3.5 3.5 6.5C19 15.5 12 20 12 20Z"/>',
  },
  {
    title: 'Atención personalizada',
    text: 'Nos adaptamos al carácter y las necesidades de tu perro.',
    icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"/>',
  },
  {
    title: 'Seguridad',
    text: 'Espacios pensados para que tu perro esté tranquilo y a salvo.',
    icon: '<path d="M12 3 5 6v5c0 4.5 3 8 7 9 4-1 7-4.5 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    title: 'Higiene',
    text: 'Limpieza y orden como parte del día a día.',
    icon: '<path d="M4 12h16M6 12v7a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-7M9 8V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/>',
  },
  {
    title: 'Trato profesional',
    text: 'Experiencia y método en el cuidado y el manejo de perros.',
    icon: '<path d="M20 7h-4V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2ZM10 5h4v2h-4Z"/>',
  },
  {
    title: 'Amor por los perros',
    text: 'Hacemos esto porque nos encantan los perros. Se nota.',
    icon: '<path d="M6.5 11.5a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm11 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm-7.6-3.2a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm4.2 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4ZM12 12.5c2.5 0 4.8 1.9 5.3 4.3.3 1.4-.8 2.7-2.2 2.7-.9 0-1.7-.4-3.1-.4s-2.2.4-3.1.4c-1.4 0-2.5-1.3-2.2-2.7.5-2.4 2.8-4.3 5.3-4.3Z"/>',
  },
];
---

<section id="confianza" class="relative bg-cream-deep py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-700 uppercase tracking-[0.16em] text-clay">
        Por qué confiar en nosotros
      </p>
      <h2 class="text-balance font-display text-3xl font-600 text-forest sm:text-4xl">
        El cuidado que te gustaría para tu perro
      </h2>
      <p class="mt-4 text-pretty text-lg text-bark/75">
        Cuidamos a tu perro con cercanía, profesionalidad y mucho cariño.
      </p>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-xl2 border border-bark/10 bg-bark/10 sm:grid-cols-2 lg:grid-cols-3">
      {
        pillars.map((p) => (
          <div class="flex items-start gap-4 bg-cream p-7">
            <span
              class="mt-0.5 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-forest text-cream"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5"
                fill={p.icon.includes('a2 2') ? 'currentColor' : 'none'}
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={p.icon}
              />
            </span>
            <div>
              <h3 class="font-display text-lg font-600 text-forest">{p.title}</h3>
              <p class="mt-1 text-pretty text-bark/75">{p.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
