---
import { site } from '../data/site';

const pillars = [
  {
    title: 'Cuidado cercano',
    text: 'Tratamos a cada perro como si fuera nuestro, con atención de verdad.',
    icon: '<path d="M12 20s-7-4.5-9.5-9C1 8 2.5 4.5 6 4.5c2 0 3 1.2 4 2.5 1-1.3 2-2.5 4-2.5 3.5 0 5 3.5 3.5 6.5C19 15.5 12 20 12 20Z"/>',
  },
  {
    title: 'Atención personalizada',
    text: 'Nos adaptamos al carácter y las necesidades de tu perro.',
    icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"/>',
  },
  {
    title: 'Seguridad',
    text: 'Espacios pensados para que tu perro esté tranquilo y a salvo.',
    icon: '<path d="M12 3 5 6v5c0 4.5 3 8 7 9 4-1 7-4.5 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    title: 'Higiene',
    text: 'Limpieza y orden como parte del día a día.',
    icon: '<path d="M4 12h16M6 12v7a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-7M9 8V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/>',
  },
  {
    title: 'Trato profesional',
    text: 'Cuidado y manejo de perros con dedicación y método.',
    icon: '<path d="M20 7h-4V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2ZM10 5h4v2h-4Z"/>',
  },
  {
    title: 'Amor por los perros',
    text: 'Hacemos esto porque nos encantan los perros. Se nota.',
    icon: '<path d="M4 11 12 4l8 7"/><path d="M6.5 9.5V19h11V9.5"/><path d="M12 16.3c-1.2-.85-2-1.5-2-2.45a1.1 1.1 0 0 1 2-.62 1.1 1.1 0 0 1 2 .62c0 .95-.8 1.6-2 2.45Z"/>',
  },
];
---

<section id="confianza" class="relative bg-crema-honda py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-700 tracking-[0.05em] text-albero-ink">
        Por qué confiar en nosotros
      </p>
      <h2 class="text-balance font-display text-2xl font-600 text-rio sm:text-3xl">
        El cuidado que te gustaría para tu perro
      </h2>
      <p class="mt-4 text-pretty text-lg text-tinta/75">
        Cuidamos a cada perro en un espacio pensado para el descanso, el cuidado
        y la atención cercana. Así trabajamos.
      </p>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-xl2 border border-piedra bg-piedra sm:grid-cols-2 lg:grid-cols-3">
      {
        pillars.map((p) => (
          <div class="flex items-start gap-4 bg-hueso p-7">
            <span
              class="mt-0.5 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-rio text-hueso"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5"
                fill={p.icon.includes('a2 2') ? 'currentColor' : 'none'}
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={p.icon}
              />
            </span>
            <div>
              <h3 class="font-display text-lg font-600 text-rio">{p.title}</h3>
              <p class="mt-1 text-pretty text-tinta/75">{p.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!--
      PROPIETARIO: cuando los tengas, este bloque está preparado para añadir
      confianza real: tu historia, una foto del responsable y, más adelante,
      reseñas de clientes. Mientras tanto enlazamos a Instagram (canal real).
    -->
    <div class="mt-10 flex flex-col gap-3 rounded-xl2 border border-piedra bg-hueso p-7 shadow-sm sm:flex-row sm:items-center sm:justify-between">
      <p class="text-pretty text-tinta/75">
        Te contamos nuestro día a día y el espacio en Mula en Instagram.
      </p>
      <a
        href={site.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-2 font-700 text-albero-ink underline-offset-4 hover:underline"
      >
        Síguenos en Instagram {site.instagramHandle}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
