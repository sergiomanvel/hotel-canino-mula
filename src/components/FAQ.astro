---
import { faqs } from '../data/faq';
import { WHATSAPP_LINK } from '../data/site';
---

<section id="faq" class="bg-cream-deep py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-5 sm:px-8">
    <div class="text-center">
      <p class="mb-3 text-sm font-700 uppercase tracking-[0.16em] text-clay">
        Preguntas frecuentes
      </p>
      <h2 class="text-balance font-display text-3xl font-600 text-forest sm:text-4xl">
        Resolvemos tus dudas
      </h2>
    </div>

    <div class="mt-12 space-y-3">
      {
        faqs.map((faq, i) => (
          <details
            class="group rounded-2xl border border-bark/10 bg-cream px-6 py-1 transition-colors open:border-clay/40 open:bg-white"
            name="faq"
            open={i === 0}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left font-display text-lg font-600 text-forest marker:hidden">
              {faq.question}
              <span
                class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-moss/15 text-forest transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="pb-5 text-pretty text-bark/80">{faq.answer}</p>
          </details>
        ))
      }
    </div>

    <p class="mt-10 text-center text-bark/75">
      ¿Tienes otra pregunta?{' '}
      <a
        href={WHATSAPP_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="font-700 text-clay underline-offset-4 hover:underline"
      >
        Escríbenos por WhatsApp
      </a>
    </p>
  </div>
</section>
