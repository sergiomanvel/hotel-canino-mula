---
interface Props {
  status: string;
}

const { status } = Astro.props;

const styles: Record<string, string> = {
  nueva: 'border-albero/30 bg-albero/15 text-albero-ink',
  contactada: 'border-ribera/40 bg-ribera/15 text-ribera',
  confirmada: 'border-rio/30 bg-rio/15 text-rio',
  rechazada: 'border-tinta/30 bg-tinta/10 text-tinta/70',
};

const labels: Record<string, string> = {
  nueva: 'Nueva',
  contactada: 'Contactada',
  confirmada: 'Confirmada',
  rechazada: 'Rechazada',
};

const cls = styles[status] ?? 'border-tinta/20 bg-tinta/10 text-tinta';
const label = labels[status] ?? status;
---

<span class={`inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-700 ${cls}`}>
  {label}
</span>
