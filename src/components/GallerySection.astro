---
/*
  Galería — el reportaje completo del recinto.

  Estructura: el díptico editorial que abría el bloque (P010 y P015) se mantiene
  intacto arriba, y debajo va la colección completa con las 23 fotografías que
  no viven en otra sección. Con el hero, hospedaje y entorno, las 28 del
  reportaje están en el HTML de la home.

  Rejilla de proporción constante: 22 de las 23 son 9:16, así que una rejilla de
  1/2/3 columnas se maqueta llena sin recortar ni forzar formas. La única toma
  apaisada (P001) ocupa la fila entera, que es la forma de que ninguna fila
  quede coja. Sin `object-cover`: cada fotografía conserva su relación de
  aspecto.

  Sin carrusel, sin lightbox, sin JavaScript, sin paginación y sin «ver más».
  Todo se encuentra desplazándose. `loading="lazy"` mantiene las imágenes en el
  HTML y solo retrasa su descarga hasta acercarse al viewport.
*/
import { Picture } from 'astro:assets';
import { fotos, galeriaCompleta, ABRIR_COMPLETA, type Foto, type GrupoGaleria } from '../data/fotos';

const dipticoDestacado = [fotos.casetaExterior, fotos.portonMural] satisfies Foto[];

/*
  El enlace de tamaño completo apunta al máster importado: `ImageMetadata.src`
  es la URL con hash que Astro emite para el propio archivo, sin transformarlo.
  Así el clic entrega el JPEG original —misma resolución, mismos píxeles— sin
  una tercera generación de compresión y sin tocar `media-source/`.
*/

const bloques: { grupo: GrupoGaleria; titulo: string; nota: string }[] = [
  {
    grupo: 'perros',
    titulo: 'Perros',
    nota: 'Perros fotografiados en el recinto.',
  },
  {
    grupo: 'apertura',
    titulo: 'Apertura',
    nota: 'Imágenes del acto celebrado en las instalaciones.',
  },
];

const enlaceClase =
  'group block overflow-hidden rounded-xl2 border border-piedra bg-crema transition-colors hover:border-albero/50';
---

<section id="galeria" class="bg-hueso py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-700 tracking-[0.05em] text-albero-ink">
        Galería
      </p>
      <h2 class="text-balance font-display text-2xl font-600 text-rio sm:text-3xl">
        Conoce el espacio y nuestra historia en imágenes
      </h2>
      <p class="mt-4 text-pretty text-lg text-tinta/75">
        Instalaciones, entorno y momentos de Hotel Canino Río Mula, en la Ctra.
        de Pliego.
      </p>
    </div>

    <!-- Díptico de apertura: vertical 3:4 a la izquierda, cuadrada desplazada a la derecha -->
    <div class="mt-12 grid gap-6 sm:grid-cols-2 sm:items-start sm:gap-8">
      {
        dipticoDestacado.map((foto, i) => (
          <figure class={i === 1 ? 'sm:mt-14' : undefined}>
            <a
              href={foto.completa.src}
              target="_blank"
              rel="noopener"
              class={enlaceClase}
            >
              <Picture
                src={foto.src}
                alt={foto.alt}
                formats={['avif', 'webp']}
                widths={i === 0 ? [300, 450, 600, 900] : [360, 540, 720, 1100, 1600]}
                sizes="(min-width: 1216px) 532px, (min-width: 640px) 45vw, calc(100vw - 2.5rem)"
                loading="lazy"
                decoding="async"
                class="w-full"
              />
              <span class="sr-only">{ABRIR_COMPLETA}</span>
            </a>
            <figcaption class="mt-3 text-sm text-tinta/70">{foto.caption}</figcaption>
          </figure>
        ))
      }
    </div>

    <!--
      Colección completa. Cada bloque lleva un rótulo factual para no mezclar
      las tomas del acto con el funcionamiento cotidiano.
    -->
    {
      bloques.map(({ grupo, titulo, nota }) => (
        <div class="mt-16 border-t border-piedra pt-10 sm:mt-20">
          <h3 class="font-display text-xl font-600 text-rio">{titulo}</h3>
          <p class="mt-1 text-pretty text-tinta/70">{nota}</p>

          <ul class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {galeriaCompleta
              .filter((foto) => foto.grupo === grupo)
              .map((foto) => (
                <li class={foto.ancha ? 'sm:col-span-2 lg:col-span-3' : undefined}>
                  <figure>
                    <a
                      href={foto.completa.src}
                      target="_blank"
                      rel="noopener"
                      class={enlaceClase}
                    >
                      <Picture
                        src={foto.src}
                        alt={foto.alt}
                        formats={['avif', 'webp']}
                        widths={foto.widths}
                        sizes={foto.sizes}
                        loading="lazy"
                        decoding="async"
                        class="w-full"
                      />
                      <span class="sr-only">{ABRIR_COMPLETA}</span>
                    </a>
                  </figure>
                </li>
              ))}
          </ul>
        </div>
      ))
    }

    <!--
      Compromiso vigente sobre las fotos de perros de clientes. Se mantiene
      alineado con la FAQ, la página de privacidad y la casilla `photo-consent`
      del formulario de reserva.
    -->
    <p class="mt-14 max-w-2xl text-pretty text-sm text-tinta/70">
      Publicamos fotos de perros de clientes únicamente con su permiso. Puedes
      darlo, o no, en el formulario de reserva.
    </p>
  </div>
</section>
