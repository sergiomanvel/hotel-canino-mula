---
/*
  Galería — díptico editorial con las fotografías reales del espacio.

  Dos imágenes, no cuatro: se maqueta llena en lugar de dejar huecos. Las
  proporciones son distintas a propósito (3:4 y 1:1) y la segunda va desplazada
  hacia abajo, para que el bloque se lea como un díptico y no como una
  cuadrícula. Sin carrusel, sin lightbox, sin JavaScript.
*/
import { Picture } from 'astro:assets';
import { fotos } from '../data/fotos';
---

<section id="galeria" class="bg-hueso py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-700 tracking-[0.05em] text-albero-ink">
        Galería
      </p>
      <h2 class="text-balance font-display text-2xl font-600 text-rio sm:text-3xl">
        El espacio donde se alojará tu perro
      </h2>
      <p class="mt-4 text-pretty text-lg text-tinta/75">
        Un entorno cómodo y seguro en Mula. Estas son las instalaciones en la
        Ctra. de Pliego.
      </p>
    </div>

    <!-- Díptico: vertical 3:4 a la izquierda, cuadrada desplazada a la derecha -->
    <div class="mt-12 grid gap-6 sm:grid-cols-2 sm:items-start sm:gap-8">
      <figure>
        <div class="overflow-hidden rounded-xl2 border border-piedra">
          <Picture
            src={fotos.casetaExterior.src}
            alt={fotos.casetaExterior.alt}
            formats={['avif', 'webp']}
            widths={[300, 450, 600, 900]}
            sizes="(min-width: 1216px) 532px, (min-width: 640px) 45vw, calc(100vw - 2.5rem)"
            loading="lazy"
            class="w-full"
          />
        </div>
        <figcaption class="mt-3 text-sm text-tinta/70">
          {fotos.casetaExterior.caption}
        </figcaption>
      </figure>

      <figure class="sm:mt-14">
        <div class="overflow-hidden rounded-xl2 border border-piedra">
          <Picture
            src={fotos.portonMural.src}
            alt={fotos.portonMural.alt}
            formats={['avif', 'webp']}
            widths={[360, 540, 720, 1100, 1600]}
            sizes="(min-width: 1216px) 532px, (min-width: 640px) 45vw, calc(100vw - 2.5rem)"
            loading="lazy"
            class="w-full"
          />
        </div>
        <figcaption class="mt-3 text-sm text-tinta/70">
          {fotos.portonMural.caption}
        </figcaption>
      </figure>
    </div>

    <!-- Futuras fotos de perros (con consentimiento) -->
    <div class="mt-12 grid items-center gap-6 rounded-xl2 border border-dashed border-albero/40 bg-crema-honda p-7 sm:grid-cols-[auto_1fr]">
      <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-albero/15 text-albero-ink" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="11" r="2" /><path d="m3 17 5-4 4 3 3-2 6 4" />
        </svg>
      </span>
      <div>
        <p class="font-display text-lg font-600 text-rio">Fotos de perros</p>
        <p class="mt-1 text-pretty text-tinta/75">
          Las fotos de perros se publicarán solo con permiso del cliente. Podrás
          indicar tu consentimiento en el formulario de reserva.
        </p>
      </div>
    </div>
  </div>
</section>
