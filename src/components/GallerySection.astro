---
/*
  Galería — Fase 1 (placeholders).
  PROPIETARIO: sustituye los bloques por fotos reales cuando las tengas, usando
  <img src="/images/..." alt="descripción" loading="lazy" width=".." height=".." />
  o el componente <Image> de astro:assets. No se usan imágenes externas ni
  fotos de perros reales todavía.
*/

const localShots = [
  { label: 'El espacio', tone: 'from-ribera to-ribera' },
  { label: 'Zonas de descanso', tone: 'from-albero to-tinta' },
  { label: 'Entorno tranquilo', tone: 'from-salvia to-ribera' },
  { label: 'Detalles del hospedaje', tone: 'from-rio to-ribera' },
];
---

<section id="galeria" class="bg-hueso py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-700 uppercase tracking-[0.16em] text-albero-ink">
        Galería
      </p>
      <h2 class="text-balance font-display text-2xl font-600 text-rio sm:text-3xl">
        El espacio donde se alojará tu perro
      </h2>
      <p class="mt-4 text-pretty text-lg text-tinta/75">
        Un entorno cómodo y seguro en Mula. Pronto publicaremos aquí fotos
        reales del local.
      </p>
    </div>

    <!-- Imágenes del local (placeholders) -->
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        localShots.map((shot) => (
          <figure class={`relative aspect-[4/3] overflow-hidden rounded-xl2 border border-piedra bg-gradient-to-br shadow-sm ${shot.tone}`}>
            <div class="bg-grain absolute inset-0 opacity-40" aria-hidden="true" />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent p-5">
              <p class="font-display text-lg font-600 text-hueso">{shot.label}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <!-- Futuras fotos de perros (con consentimiento) -->
    <div class="mt-8 grid items-center gap-6 rounded-xl2 border border-dashed border-albero/40 bg-crema-honda p-7 sm:grid-cols-[auto_1fr]">
      <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-albero/15 text-albero-ink" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="11" r="2" /><path d="m3 17 5-4 4 3 3-2 6 4" />
        </svg>
      </span>
      <div>
        <p class="font-display text-lg font-600 text-rio">Fotos de perros</p>
        <p class="mt-1 text-pretty text-tinta/75">
          Las fotos de perros se publicarán solo con permiso del cliente. Podrás
          indicar tu consentimiento en el formulario de reserva.
        </p>
      </div>
    </div>

    <p class="mt-6 text-sm text-tinta/60">
      Fotos reales del espacio próximamente.
    </p>
  </div>
</section>
