---
/*
  Galería — Fase 1 (placeholders).
  PROPIETARIO: sustituye los bloques por fotos reales cuando las tengas, usando
  <img src="/images/..." alt="descripción" loading="lazy" width=".." height=".." />
  o el componente <Image> de astro:assets. No se usan imágenes externas ni
  fotos de perros reales todavía.
*/

const localShots = [
  { label: 'El espacio', tone: 'from-moss to-forest-700' },
  { label: 'Zonas de descanso', tone: 'from-clay to-bark' },
  { label: 'Entorno tranquilo', tone: 'from-moss-soft to-moss' },
  { label: 'Detalles del hospedaje', tone: 'from-forest to-forest-700' },
];
---

<section id="galeria" class="bg-cream py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-700 uppercase tracking-[0.16em] text-clay">
        Galería
      </p>
      <h2 class="text-balance font-display text-3xl font-600 text-forest sm:text-4xl">
        El espacio donde se alojará tu perro
      </h2>
      <p class="mt-4 text-pretty text-lg text-bark/75">
        Estamos preparando un entorno cómodo y seguro en Mula. Pronto
        publicaremos fotos reales del local.
      </p>
    </div>

    <!-- Imágenes del local (placeholders) -->
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        localShots.map((shot) => (
          <figure class={`relative aspect-[4/3] overflow-hidden rounded-xl2 border border-bark/10 bg-gradient-to-br ${shot.tone}`}>
            <div class="bg-grain absolute inset-0 opacity-40" aria-hidden="true" />
            <span class="absolute right-3 top-3 rounded-full bg-cream/90 px-3 py-1 text-xs font-700 uppercase tracking-wide text-bark">
              Imagen provisional
            </span>
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent p-5">
              <p class="font-display text-lg font-600 text-cream">{shot.label}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <!-- Futuras fotos de perros (con consentimiento) -->
    <div class="mt-8 grid items-center gap-6 rounded-xl2 border border-dashed border-clay/40 bg-cream-deep p-7 sm:grid-cols-[auto_1fr]">
      <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-clay/15 text-clay" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="11" r="2" /><path d="m3 17 5-4 4 3 3-2 6 4" />
        </svg>
      </span>
      <div>
        <p class="font-display text-lg font-600 text-forest">Fotos de perros</p>
        <p class="mt-1 text-pretty text-bark/75">
          Las fotos de perros se publicarán solo con permiso del cliente. Podrás
          indicar tu consentimiento en el formulario de reserva.
        </p>
      </div>
    </div>

    <p class="mt-6 text-sm text-bark/60">
      * Imágenes provisionales hasta disponer de fotografías reales del hotel.
    </p>
  </div>
</section>
