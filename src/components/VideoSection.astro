---
/*
  Vídeo — Fase 1 (placeholder).
  PROPIETARIO: cuando tengas el vídeo cinematográfico, sustituye este bloque.
  Recomendado para no penalizar rendimiento: una "fachada" (póster + botón) que
  cargue el vídeo solo al pulsar, o <video> con preload="none" y poster.
  En esta fase NO se carga vídeo, NO se usa iframe ni recursos externos.
*/
---

<section id="video" class="bg-rio py-20 text-hueso sm:py-28">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="mb-3 text-sm font-700 uppercase tracking-[0.16em] text-albero-soft">
        Vídeo
      </p>
      <h2 class="text-balance font-display text-2xl font-600 sm:text-3xl">
        Pronto, un vídeo del espacio
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-lg text-hueso/85">
        Próximamente añadiremos un vídeo del espacio para que conozcas dónde se
        alojará tu perro antes de reservar.
      </p>
    </div>

    <!-- Marco de vídeo (placeholder, sin reproducción) -->
    <div
      class="relative mt-10 flex aspect-video items-center justify-center overflow-hidden rounded-xl2 border border-hueso/15 bg-[linear-gradient(160deg,#3c5045,#233028)]"
      role="img"
      aria-label="Espacio reservado para un vídeo del hotel canino, próximamente disponible"
    >
      <div class="bg-grain absolute inset-0 opacity-40" aria-hidden="true"></div>
      <div class="relative flex flex-col items-center gap-4 text-center">
        <span class="inline-flex h-20 w-20 items-center justify-center rounded-2xl bg-hueso/10 text-hueso ring-1 ring-hueso/20" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-9 w-9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M3 9h18M7 5v4M12 5v4M17 5v4" />
          </svg>
        </span>
        <span class="rounded-full bg-hueso/10 px-4 py-1.5 text-xs font-700 uppercase tracking-[0.16em] text-albero-soft">
          Vídeo próximamente
        </span>
      </div>
    </div>
  </div>
</section>
