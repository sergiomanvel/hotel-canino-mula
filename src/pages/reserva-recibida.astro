---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`Solicitud recibida | ${site.name}`}
  description="Hemos recibido tu solicitud de reserva en Hotel Canino Río Mula. Te contactaremos personalmente para confirmar disponibilidad."
  noindex
>
  <main id="main" class="bg-hueso">
    <section class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-5 py-20 text-center sm:px-8 sm:py-28">
      <span
        class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-ribera/12 text-rio"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </span>

      <h1 class="mt-6 text-balance font-display text-4xl font-600 text-rio sm:text-5xl">
        Solicitud recibida
      </h1>

      <p class="mt-5 max-w-xl text-pretty text-lg text-tinta/75">
        Gracias por enviarnos los datos de tu perro. Hemos recibido tu solicitud
        de reserva correctamente.
      </p>

      <!-- Aviso clave: la solicitud NO es una reserva confirmada -->
      <p
        role="note"
        class="mt-7 flex items-start gap-3 rounded-2xl border border-albero/30 bg-albero/10 px-5 py-4 text-left text-pretty text-tinta"
      >
        <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 text-albero-ink" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path d="M12 8v5" stroke-linecap="round" /><path d="M12 16h.01" stroke-linecap="round" />
        </svg>
        <span>
          <strong class="font-700">Tu reserva todavía no está confirmada.</strong>
          Revisaremos tu solicitud y te contactaremos personalmente para ver la
          disponibilidad y cerrar los detalles.
        </span>
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-rio px-7 py-4 text-base font-700 text-hueso shadow-sm transition-all hover:bg-ribera"
        >
          Volver al inicio
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
