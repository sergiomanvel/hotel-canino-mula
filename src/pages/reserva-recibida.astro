---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, WHATSAPP_LINK } from '../data/site';
---

<BaseLayout
  title={`Solicitud recibida | ${site.name}`}
  description="Hemos recibido tu solicitud de reserva en Hotel Canino Río Mula. Te contactaremos personalmente para confirmar disponibilidad."
>
  <main id="main" class="bg-cream">
    <section class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-5 py-20 text-center sm:px-8 sm:py-28">
      <span
        class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-moss/12 text-forest"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </span>

      <h1 class="mt-6 text-balance font-display text-4xl font-600 text-forest sm:text-5xl">
        Solicitud recibida
      </h1>

      <p class="mt-5 max-w-xl text-pretty text-lg text-bark/75">
        Gracias por enviarnos los datos de tu perro. Hemos recibido tu solicitud
        de reserva correctamente.
      </p>

      <!-- Aviso clave: la solicitud NO es una reserva confirmada -->
      <p
        role="note"
        class="mt-7 flex items-start gap-3 rounded-2xl border border-clay/30 bg-clay/10 px-5 py-4 text-left text-pretty text-bark"
      >
        <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 text-clay" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path d="M12 8v5" stroke-linecap="round" /><path d="M12 16h.01" stroke-linecap="round" />
        </svg>
        <span>
          <strong class="font-700">Tu reserva todavía no está confirmada.</strong>
          Revisaremos tu solicitud y te contactaremos personalmente para ver la
          disponibilidad y cerrar los detalles.
        </span>
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-forest px-7 py-4 text-base font-700 text-cream shadow-sm transition-all hover:bg-forest-700"
        >
          Volver al inicio
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={WHATSAPP_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 rounded-full border border-forest/25 px-7 py-4 text-base font-700 text-forest transition-colors hover:bg-forest/5"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zM6.597 20.13c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.512 5.26l-.999 3.648 3.976-1.207zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"></path>
          </svg>
          ¿Dudas? Escríbenos por WhatsApp
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
