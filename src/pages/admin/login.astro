---
import '../../styles/global.css';

export const prerender = false;

const hasError = Astro.url.searchParams.get('error') === '1';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Acceso · Hotel Canino Río Mula</title>
  </head>
  <body class="min-h-screen bg-crema-honda text-tinta">
    <main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-5 py-12">
      <div class="rounded-xl2 border border-tinta/10 bg-hueso p-8 shadow-sm">
        <p class="mb-2 text-sm font-700 uppercase tracking-[0.16em] text-albero-ink">Panel privado</p>
        <h1 class="font-display text-3xl font-600 text-rio">Iniciar sesión</h1>
        <p class="mt-3 text-pretty text-tinta/75">
          Acceso privado para la gestión de reservas.
        </p>

        {hasError && (
          <p
            role="alert"
            class="mt-5 rounded-xl border border-albero/40 bg-albero/10 px-4 py-3 text-sm font-600 text-tinta"
          >
            No hemos podido iniciar sesión con esos datos.
          </p>
        )}

        <form method="POST" action="/api/admin/login" class="mt-6 grid gap-5">
          <div class="flex flex-col gap-2">
            <label for="email" class="font-600 text-rio">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="rounded-xl border border-tinta/20 bg-white px-4 py-3 text-tinta outline-none focus:border-albero"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="password" class="font-600 text-rio">Contraseña</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              class="rounded-xl border border-tinta/20 bg-white px-4 py-3 text-tinta outline-none focus:border-albero"
            />
          </div>

          <button
            type="submit"
            class="mt-1 inline-flex items-center justify-center gap-2 rounded-full bg-rio px-7 py-3.5 text-base font-700 text-hueso shadow-sm transition-all hover:bg-ribera"
          >
            Entrar
          </button>
        </form>
      </div>

      <p class="mt-6 text-center text-sm text-tinta/60">
        <a href="/" class="font-600 text-albero-ink underline-offset-4 hover:underline">← Volver a la web</a>
      </p>
    </main>
  </body>
</html>
