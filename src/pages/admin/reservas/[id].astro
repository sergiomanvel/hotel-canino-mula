---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import { createSupabaseServerClient } from '../../../lib/supabaseAuthServer';

export const prerender = false;

const STATUSES = ['nueva', 'contactada', 'confirmada', 'rechazada'] as const;
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const { id } = Astro.params;
const updated = Astro.url.searchParams.get('updated') === '1';

let reservation: Record<string, any> | null = null;
let loadError = false;

if (id && UUID_RE.test(id)) {
  const supabase = createSupabaseServerClient(Astro);
  const { data, error } = await supabase
    .from('reservations')
    .select('*')
    .eq('id', id)
    .maybeSingle();
  if (error) {
    console.error('[admin] Error al cargar la reserva:', error.message);
    loadError = true;
  } else {
    reservation = data;
  }
}

if (!reservation && !loadError) {
  Astro.response.status = 404;
}

const fmtDateTime = (iso: string) =>
  new Date(iso).toLocaleString('es-ES', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });

// --- Perfil del perro (migración 0003) -------------------------------------
// En la base de datos viajan claves estables en inglés; aquí se traducen para
// leerlas de un vistazo. Las reservas anteriores a esta ampliación tienen NULL
// en todas estas columnas, así que se muestran como "No indicado" en lugar de
// romper la ficha.
const VALUE_LABELS: Record<string, string> = {
  yes: 'Sí',
  no: 'No',
  unknown: 'No lo sabe',
  depends: 'Depende',
  male: 'Macho',
  female: 'Hembra',
};

const show = (value: unknown): string => {
  if (value === null || value === undefined || value === '') return 'No indicado';
  const key = String(value);
  return VALUE_LABELS[key] ?? key;
};

interface Row {
  label: string;
  value: string;
  wide?: boolean;
}

const dogProfileRows = (r: Record<string, any>): Row[] => [
  { label: 'Sexo', value: show(r.dog_sex) },
  { label: 'Edad aproximada', value: show(r.dog_age) },
  { label: 'Esterilizado', value: show(r.dog_neutered) },
  { label: 'Vacunas al día', value: show(r.dog_vaccinations_up_to_date) },
];

const behaviourRows = (r: Record<string, any>): Row[] => [
  { label: 'Sociable con otros perros', value: show(r.dog_social_with_dogs) },
  { label: 'Sociable con desconocidos', value: show(r.dog_social_with_people) },
  { label: 'Conductas agresivas previas', value: show(r.dog_aggression_history) },
  ...(r.dog_aggression_details
    ? [{ label: 'En qué situaciones', value: r.dog_aggression_details, wide: true }]
    : []),
  { label: 'Miedos importantes', value: show(r.dog_has_fears) },
  ...(r.dog_fears_details ? [{ label: 'Cuáles', value: r.dog_fears_details, wide: true }] : []),
  { label: 'Intenta escapar o saltar vallas', value: show(r.dog_escape_attempts) },
  { label: 'Ansiedad por separación', value: show(r.dog_separation_anxiety) },
];

const feedingRows = (r: Record<string, any>): Row[] => [
  { label: 'Alergias o intolerancias', value: show(r.dog_has_allergies_or_intolerances) },
  ...(r.dog_allergies_or_intolerances_details
    ? [{ label: 'Cuáles', value: r.dog_allergies_or_intolerances_details, wide: true }]
    : []),
  { label: 'Tipo de alimentación habitual', value: show(r.dog_feeding_type) },
  { label: 'Trae su propia comida', value: show(r.dog_brings_own_food) },
];
---

<AdminLayout title="Detalle de reserva">
  <a href="/admin" class="inline-flex items-center gap-2 font-700 text-albero-ink underline-offset-4 hover:underline">
    <span aria-hidden="true">←</span> Volver al listado
  </a>

  {
    !reservation ? (
      <div class="mt-8 rounded-xl2 border border-dashed border-tinta/20 bg-hueso px-6 py-12 text-center">
        <h1 class="font-display text-2xl font-600 text-rio">Reserva no encontrada</h1>
        <p class="mt-2 text-tinta/70">
          {loadError
            ? 'No hemos podido cargar la reserva en este momento.'
            : 'No existe ninguna solicitud con ese identificador.'}
        </p>
      </div>
    ) : (
      <>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
          <h1 class="font-display text-3xl font-600 text-rio sm:text-4xl">
            Reserva de {reservation.owner_name}
          </h1>
          <StatusBadge status={reservation.status} />
        </div>
        <p class="mt-1 text-sm text-tinta/60">Recibida el {fmtDateTime(reservation.created_at)}</p>

        {updated && (
          <p
            role="status"
            class="mt-5 rounded-xl border border-rio/30 bg-rio/10 px-5 py-3 text-sm font-600 text-rio"
          >
            Cambios guardados correctamente.
          </p>
        )}

        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          <section class="rounded-xl2 border border-tinta/10 bg-hueso p-6">
            <h2 class="font-display text-lg font-600 text-rio">Propietario</h2>
            <dl class="mt-3 space-y-2 text-sm">
              <div class="flex justify-between gap-4">
                <dt class="text-tinta/60">Nombre</dt>
                <dd class="text-right font-600 text-tinta">{reservation.owner_name}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-tinta/60">Teléfono</dt>
                <dd class="text-right text-tinta">
                  <a href={`tel:${reservation.owner_phone}`} class="text-albero-ink hover:underline">
                    {reservation.owner_phone}
                  </a>
                </dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-tinta/60">Email</dt>
                <dd class="text-right break-all text-tinta">
                  <a href={`mailto:${reservation.owner_email}`} class="text-albero-ink hover:underline">
                    {reservation.owner_email}
                  </a>
                </dd>
              </div>
            </dl>
          </section>

          <section class="rounded-xl2 border border-tinta/10 bg-hueso p-6">
            <h2 class="font-display text-lg font-600 text-rio">Perro y estancia</h2>
            <dl class="mt-3 space-y-2 text-sm">
              <div class="flex justify-between gap-4">
                <dt class="text-tinta/60">Nombre</dt>
                <dd class="text-right font-600 text-tinta">{reservation.dog_name}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-tinta/60">Tamaño / raza</dt>
                <dd class="text-right text-tinta">{reservation.dog_size_or_breed ?? '—'}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-tinta/60">Entrada</dt>
                <dd class="text-right text-tinta">{reservation.start_date ?? '—'}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-tinta/60">Salida</dt>
                <dd class="text-right text-tinta">{reservation.end_date ?? '—'}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-tinta/60">Consiente fotos</dt>
                <dd class="text-right text-tinta">{reservation.accepts_photos ? 'Sí' : 'No'}</dd>
              </div>
            </dl>
          </section>
        </div>

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
          <section class="rounded-xl2 border border-tinta/10 bg-hueso p-6">
            <h2 class="font-display text-lg font-600 text-rio">Datos del perro</h2>
            <dl class="mt-3 space-y-2 text-sm">
              {dogProfileRows(reservation).map((row) => (
                <div class="flex justify-between gap-4">
                  <dt class="text-tinta/60">{row.label}</dt>
                  <dd class="text-right text-tinta">{row.value}</dd>
                </div>
              ))}
            </dl>
          </section>

          <section class="rounded-xl2 border border-tinta/10 bg-hueso p-6">
            <h2 class="font-display text-lg font-600 text-rio">Comportamiento</h2>
            <dl class="mt-3 space-y-2 text-sm">
              {behaviourRows(reservation).map((row) =>
                row.wide ? (
                  <div class="border-t border-tinta/10 pt-2">
                    <dt class="text-tinta/60">{row.label}</dt>
                    <dd class="mt-1 whitespace-pre-line text-pretty text-tinta">{row.value}</dd>
                  </div>
                ) : (
                  <div class="flex justify-between gap-4">
                    <dt class="text-tinta/60">{row.label}</dt>
                    <dd class="text-right text-tinta">{row.value}</dd>
                  </div>
                )
              )}
            </dl>
          </section>
        </div>

        <section class="mt-6 rounded-xl2 border border-tinta/10 bg-hueso p-6">
          <h2 class="font-display text-lg font-600 text-rio">Alimentación y cuidados</h2>
          <dl class="mt-3 space-y-2 text-sm">
            {feedingRows(reservation).map((row) =>
              row.wide ? (
                <div class="border-t border-tinta/10 pt-2">
                  <dt class="text-tinta/60">{row.label}</dt>
                  <dd class="mt-1 whitespace-pre-line text-pretty text-tinta">{row.value}</dd>
                </div>
              ) : (
                <div class="flex justify-between gap-4">
                  <dt class="text-tinta/60">{row.label}</dt>
                  <dd class="text-right text-tinta">{row.value}</dd>
                </div>
              )
            )}
            <div class="border-t border-tinta/10 pt-3">
              <dt class="text-tinta/60">Observaciones o cuidados especiales</dt>
              <dd class="mt-1 whitespace-pre-line text-pretty text-tinta/80">
                {reservation.dog_notes ?? 'Sin indicaciones.'}
              </dd>
            </div>
          </dl>
        </section>

        <!-- Gestión: estado + notas internas -->
        <section class="mt-6 rounded-xl2 border border-tinta/10 bg-hueso p-6">
          <h2 class="font-display text-lg font-600 text-rio">Gestión</h2>
          <form method="POST" action={`/api/admin/reservas/${reservation.id}`} class="mt-4 grid gap-5">
            <div class="flex flex-col gap-2">
              <label for="status" class="font-600 text-rio">Estado</label>
              <select
                id="status"
                name="status"
                class="rounded-xl border border-tinta/20 bg-white px-4 py-3 text-tinta outline-none focus:border-albero"
              >
                {STATUSES.map((s) => (
                  <option value={s} selected={s === reservation.status}>
                    {s.charAt(0).toUpperCase() + s.slice(1)}
                  </option>
                ))}
              </select>
            </div>

            <div class="flex flex-col gap-2">
              <label for="internal_notes" class="font-600 text-rio">Notas internas</label>
              <textarea
                id="internal_notes"
                name="internal_notes"
                rows="4"
                maxlength="2000"
                placeholder="Anotaciones privadas para la gestión (no visibles para el cliente)."
                class="rounded-xl border border-tinta/20 bg-white px-4 py-3 text-tinta placeholder:text-tinta/45 outline-none focus:border-albero"
              >{reservation.internal_notes ?? ''}</textarea>
            </div>

            <div class="flex flex-wrap gap-3">
              <button
                type="submit"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-rio px-7 py-3.5 text-base font-700 text-hueso shadow-sm transition-all hover:bg-ribera"
              >
                Guardar cambios
              </button>
              <a
                href="/admin"
                class="inline-flex items-center justify-center gap-2 rounded-full border border-rio/25 px-7 py-3.5 text-base font-700 text-rio transition-colors hover:bg-rio/5"
              >
                Volver
              </a>
            </div>
          </form>
        </section>
      </>
    )
  }
</AdminLayout>
