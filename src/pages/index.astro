---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import TrustSection from '../components/TrustSection.astro';
import OpeningSection from '../components/OpeningSection.astro';
import BookingProcess from '../components/BookingProcess.astro';
import CoverageSection from '../components/CoverageSection.astro';
import FacilitiesSection from '../components/FacilitiesSection.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloatingButton from '../components/WhatsAppFloatingButton.astro';
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <Services />
    <TrustSection />
    <OpeningSection />
    <BookingProcess />
    <CoverageSection />
    <FacilitiesSection />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
  <WhatsAppFloatingButton />
</BaseLayout>
