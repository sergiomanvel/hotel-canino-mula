---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HospedajeSection from '../components/HospedajeSection.astro';
import TrustSection from '../components/TrustSection.astro';
import GallerySection from '../components/GallerySection.astro';
import VideoSection from '../components/VideoSection.astro';
import OpeningSection from '../components/OpeningSection.astro';
import BookingProcess from '../components/BookingProcess.astro';
import ReservationForm from '../components/ReservationForm.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <HospedajeSection />
    <TrustSection />
    <BookingProcess />
    <ReservationForm />
    <GallerySection />
    <VideoSection />
    <OpeningSection />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
