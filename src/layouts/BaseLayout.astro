---
import '../styles/global.css';
import { site } from '../data/site';
import { HOSPEDAJE_SERVICE_TYPE } from '../data/services';
import { faqs } from '../data/faq';

interface Props {
  title?: string;
  description?: string;
  /** Páginas sin valor de búsqueda (p. ej. /reserva-recibida): noindex, nofollow. */
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const ogImage = new URL('/og-image.png', Astro.site ?? site.url).toString();
const ogImageAlt =
  'Hotel Canino Río Mula — hotel y residencia canina en Mula, Región de Murcia';

// Schema JSON-LD: negocio local de hospedaje canino (servicio único, sin inventar datos).
const reservationUrl =
  new URL('/', Astro.site ?? site.url).toString().replace(/\/$/, '') + '/#reservas';
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.description,
  url: site.url,
  image: ogImage,
  sameAs: [site.instagramUrl],
  areaServed: [
    { '@type': 'City', name: 'Mula' },
    { '@type': 'City', name: 'Pliego' },
    { '@type': 'AdministrativeArea', name: 'Región de Murcia' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.streetAddress,
    postalCode: site.postalCode,
    addressLocality: 'Mula',
    addressRegion: 'Murcia',
    addressCountry: 'ES',
  },
  hasMap: site.mapsUrl,
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: 'Hospedaje canino',
      serviceType: HOSPEDAJE_SERVICE_TYPE,
    },
  },
  potentialAction: {
    '@type': 'ReserveAction',
    name: 'Solicitar reserva',
    target: reservationUrl,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#233028" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!--
      Fuentes: Newsreader (display serif) + Mulish (texto).
      Las @font-face viven en `global.css`; aquí solo queda el preconnect al
      origen que sirve los woff2. Ya no hay hoja de estilo de
      fonts.googleapis.com —bloqueaba el render ~877 ms en móvil—, así que su
      preconnect también sobra.

      Sin `preload` de los woff2, y es deliberado: se probó precargando el
      subconjunto `latin` de Newsreader (129 KB). Medido a 15 pasadas sin
      preload y 10 con él, no movía nada —Performance 92 vs 92,5; LCP 2.554 vs
      2.628 ms; mismo CLS—, así que no se conserva. `font-display: swap` ya
      cubre el caso: el texto se lee desde el primer paint.
    -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-rio focus:px-4 focus:py-2 focus:text-hueso"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
