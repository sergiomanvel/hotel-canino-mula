---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Panel de reservas' } = Astro.props;
const fullTitle = `${title} · Hotel Canino Río Mula`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen bg-cream-deep text-bark">
    <header class="border-b border-bark/10 bg-forest text-cream">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
        <div class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-cream/10 text-cream" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
              <path d="M6.5 11.5a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm11 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm-7.6-3.2a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm4.2 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4ZM12 12.5c2.5 0 4.8 1.9 5.3 4.3.3 1.4-.8 2.7-2.2 2.7-.9 0-1.7-.4-3.1-.4s-2.2.4-3.1.4c-1.4 0-2.5-1.3-2.2-2.7.5-2.4 2.8-4.3 5.3-4.3Z"></path>
            </svg>
          </span>
          <span class="flex flex-col leading-tight">
            <span class="font-display text-base font-600">Hotel Canino Río Mula</span>
            <span class="text-[0.65rem] font-600 uppercase tracking-[0.18em] text-clay-soft">Admin</span>
          </span>
        </div>

        <form method="POST" action="/api/admin/logout">
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-full border border-cream/25 px-4 py-2 text-sm font-700 text-cream transition-colors hover:bg-cream/10"
          >
            Cerrar sesión
          </button>
        </form>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-5 py-10 sm:px-8 sm:py-14">
      <slot />
    </main>
  </body>
</html>
