# =============================================================
#  Hotel Canino Río Mula — variables de entorno (PLANTILLA)
# =============================================================
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA commitees `.env` (ya está en .gitignore). Aquí no hay secretos.
#
# Los valores reales se obtienen en el panel de Supabase:
#   Project Settings → API
# -------------------------------------------------------------

# URL del proyecto Supabase. Prefijo PUBLIC_ => puede usarse en el
# cliente (navegador). No es secreta.
PUBLIC_SUPABASE_URL=

# Clave anónima (publicable). Prefijo PUBLIC_ => puede usarse en el
# cliente. Está protegida por Row Level Security; NO da acceso a las
# reservas. Se reservará para el panel /admin (Fase 2B).
PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role. SECRETO DE SERVIDOR: omite RLS y da acceso total.
# - Solo se usa en endpoints server-side (p. ej. /api/reservas).
# - NUNCA la pongas en variables PUBLIC_ ni la expongas al cliente.
# - NUNCA la commitees.
SUPABASE_SERVICE_ROLE_KEY=
